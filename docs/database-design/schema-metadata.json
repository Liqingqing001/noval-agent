        "PRIMARY KEY DEFAULT gen_random_uuid()"
      ],
      [
        "chapter_id",
        "uuid",
        "所属正文",
        "NOT NULL REFERENCES chapter(id) ON DELETE CASCADE"
      ],
      [
        "version",
        "bigint",
        "对应正文版本",
        "NOT NULL CHECK (version >= 1)"
      ],
      [
        "title",
        "varchar(200)",
        "当时的标题",
        "NOT NULL"
      ],
      [
        "content",
        "text",
        "当时的完整正文",
        "NOT NULL DEFAULT ''"
      ],
