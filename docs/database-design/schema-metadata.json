        "timestamptz",
        "创建时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ],
      [
        "finished_at",
        "timestamptz",
        "终态完成时间",
        "NULL"
      ]
    ],
    "constraints": [
      "UNIQUE (session_id, sequence)",
      "CHECK (status NOT IN ('completed','failed','cancelled') OR finished_at IS NOT NULL)"
    ],
    "note": "Token 用量未知时保持 NULL 不虚构为零 配置删除后保留历史模型快照"
  },
  {
    "name": "chapter_revision",
    "label": "章节历史版本",
