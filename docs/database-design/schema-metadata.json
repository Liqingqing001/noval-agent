[
  {
    "name": "app_user",
    "label": "用户账户",
    "fields": [
      [
        "id",
        "uuid",
        "实体主键",
        "PRIMARY KEY DEFAULT gen_random_uuid()"
      ],
      [
        "email",
        "varchar(254)",
        "归一化邮箱",
        "NOT NULL UNIQUE CHECK (email = lower(btrim(email)) AND position('@' in email) > 1)"
      ],
      [
        "password_hash",
        "text",
        "应用层生成的密码哈希",
        "NOT NULL CHECK (length(password_hash) >= 20)"
      ],
      [
        "nickname",
        "varchar(80)",
        "显示昵称",
        "NOT NULL DEFAULT ''"
      ],
      [
        "status",
        "varchar(16)",
        "账户状态",
        "NOT NULL DEFAULT 'active' CHECK (status IN ('active','disabled'))"
      ],
      [
        "created_at",
        "timestamptz",
        "创建时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ],
      [
        "updated_at",
        "timestamptz",
        "最后更新时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ]
    ],
    "constraints": [],
    "note": ""
  },
  {
    "name": "novel",
    "label": "小说",
    "fields": [
      [
        "id",
        "uuid",
        "实体主键",
        "PRIMARY KEY DEFAULT gen_random_uuid()"
      ],
      [
        "user_id",
        "uuid",
        "拥有者",
        "NOT NULL REFERENCES app_user(id) ON DELETE RESTRICT"
      ],
      [
        "title",
        "varchar(200)",
        "小说标题",
        "NOT NULL CHECK (length(btrim(title)) > 0)"
      ],
      [
        "genre",
        "varchar(80)",
        "题材",
        "NOT NULL DEFAULT ''"
      ],
      [
        "summary",
        "text",
        "小说简介",
        "NOT NULL DEFAULT ''"
      ],
      [
        "cover_url",
        "text",
        "对象存储图片地址",
        "NOT NULL DEFAULT ''"
      ],
      [
        "agent_prompt",
        "text",
        "本书自定义提示词",
        "NOT NULL DEFAULT ''"
      ],
      [
        "status",
        "varchar(16)",
        "创作状态",
        "NOT NULL DEFAULT 'draft' CHECK (status IN ('draft','writing','completed'))"
      ],
      [
        "created_at",
        "timestamptz",
        "创建时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ],
      [
        "updated_at",
        "timestamptz",
        "最后更新时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ]
    ],
    "constraints": [
      "UNIQUE (user_id, id)"
    ],
    "note": "不持久化小说总字数 由章节汇总视图计算 避免冗余计数漂移"
  },
  {
    "name": "chapter",
    "label": "章节正文",
    "fields": [
      [
        "id",
        "uuid",
        "实体主键",
        "PRIMARY KEY DEFAULT gen_random_uuid()"
      ],
      [
        "novel_id",
        "uuid",
        "所属小说",
        "NOT NULL REFERENCES novel(id) ON DELETE CASCADE"
      ],
      [
        "title",
        "varchar(200)",
        "章节标题",
        "NOT NULL CHECK (length(btrim(title)) > 0)"
      ],
      [
        "content",
        "text",
        "正文 HTML 或纯文本",
        "NOT NULL DEFAULT ''"
      ],
      [
        "content_format",
        "varchar(8)",
        "正文格式",
        "NOT NULL DEFAULT 'html' CHECK (content_format IN ('html','text'))"
      ],
      [
        "word_count",
        "integer",
        "按统一口径统计的正文字符数",
        "NOT NULL DEFAULT 0 CHECK (word_count >= 0)"
      ],
      [
        "sequence",
        "integer",
        "同级显示顺序 从零开始",
        "NOT NULL CHECK (sequence >= 0)"
      ],
      [
        "version",
        "bigint",
        "乐观锁版本号",
        "NOT NULL DEFAULT 1 CHECK (version >= 1)"
      ],
      [
        "created_at",
        "timestamptz",
        "创建时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ],
      [
        "updated_at",
        "timestamptz",
        "最后更新时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ]
    ],
    "constraints": [
      "UNIQUE (novel_id, id)",
      "UNIQUE (novel_id, sequence) DEFERRABLE INITIALLY IMMEDIATE"
    ],
    "note": ""
  },
