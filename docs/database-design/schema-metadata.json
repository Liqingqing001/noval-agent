  {
    "name": "chapter_outline",
    "label": "章节大纲",
    "fields": [
      [
        "id",
        "uuid",
        "实体主键",
        "PRIMARY KEY DEFAULT gen_random_uuid()"
      ],
      [
        "novel_id",
        "uuid",
        "所属小说",
        "NOT NULL REFERENCES novel(id) ON DELETE CASCADE"
      ],
      [
        "volume_id",
        "uuid",
        "所属卷 可暂不归卷",
        "NULL"
      ],
      [
        "title",
        "varchar(200)",
        "章纲标题",
        "NOT NULL CHECK (length(btrim(title)) > 0)"
      ],
      [
        "summary",
        "text",
        "章纲情节",
        "NOT NULL DEFAULT ''"
      ],
      [
        "sequence",
        "integer",
        "同级显示顺序 从零开始",
        "NOT NULL CHECK (sequence >= 0)"
      ],
      [
        "status",
        "varchar(16)",
        "章纲进度",
        "NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','completed'))"
      ],
      [
        "chapter_id",
        "uuid",
        "关联正文 可为空",
        "NULL"
      ],
      [
        "created_at",
        "timestamptz",
        "创建时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ],
      [
        "updated_at",
        "timestamptz",
        "最后更新时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ]
    ],
    "constraints": [
      "UNIQUE (novel_id, id)",
      "UNIQUE (chapter_id)",
      "UNIQUE NULLS NOT DISTINCT (novel_id, volume_id, sequence) DEFERRABLE INITIALLY IMMEDIATE",
      "FOREIGN KEY (novel_id, volume_id) REFERENCES volume_outline(novel_id, id) DEFERRABLE INITIALLY DEFERRED",
      "FOREIGN KEY (novel_id, chapter_id) REFERENCES chapter(novel_id, id) DEFERRABLE INITIALLY DEFERRED",
      "CHECK (status <> 'completed' OR chapter_id IS NOT NULL)"
    ],
    "note": "同一小说中 未归卷章纲也不能出现重复顺序 一个正文最多关联一个章纲"
  },
  {
    "name": "foreshadowing",
    "label": "伏笔",
    "fields": [
      [
        "id",
        "uuid",
        "实体主键",
        "PRIMARY KEY DEFAULT gen_random_uuid()"
      ],
      [
        "novel_id",
        "uuid",
        "所属小说",
        "NOT NULL REFERENCES novel(id) ON DELETE CASCADE"
      ],
      [
        "title",
        "varchar(200)",
        "伏笔标题",
        "NOT NULL CHECK (length(btrim(title)) > 0)"
      ],
      [
        "description",
        "text",
        "伏笔说明",
        "NOT NULL DEFAULT ''"
      ],
      [
        "status",
        "varchar(16)",
        "伏笔状态",
        "NOT NULL DEFAULT 'planted' CHECK (status IN ('planted','hinted','resolved'))"
      ],
      [
        "planted_chapter_id",
        "uuid",
        "埋设正文锚点",
        "NULL"
      ],
      [
        "resolved_chapter_id",
        "uuid",
        "回收正文锚点",
        "NULL"
      ],
      [
        "planted_outline_id",
        "uuid",
        "埋设章纲锚点",
        "NULL"
      ],
      [
        "resolved_outline_id",
        "uuid",
        "回收章纲锚点",
        "NULL"
      ],
      [
        "created_at",
        "timestamptz",
        "创建时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ],
      [
        "updated_at",
        "timestamptz",
        "最后更新时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ]
    ],
    "constraints": [
      "FOREIGN KEY (novel_id, planted_chapter_id) REFERENCES chapter(novel_id, id) DEFERRABLE INITIALLY DEFERRED",
      "FOREIGN KEY (novel_id, resolved_chapter_id) REFERENCES chapter(novel_id, id) DEFERRABLE INITIALLY DEFERRED",
      "FOREIGN KEY (novel_id, planted_outline_id) REFERENCES chapter_outline(novel_id, id) DEFERRABLE INITIALLY DEFERRED",
      "FOREIGN KEY (novel_id, resolved_outline_id) REFERENCES chapter_outline(novel_id, id) DEFERRABLE INITIALLY DEFERRED",
      "CHECK (status <> 'resolved' OR resolved_chapter_id IS NOT NULL OR resolved_outline_id IS NOT NULL)"
    ],
    "note": ""
  },
  {
    "name": "model_profile",
    "label": "模型配置",
    "fields": [
      [
        "id",
        "uuid",
        "实体主键",
        "PRIMARY KEY DEFAULT gen_random_uuid()"
      ],
      [
        "user_id",
        "uuid",
        "配置拥有者",
        "NOT NULL REFERENCES app_user(id) ON DELETE CASCADE"
      ],
      [
        "name",
        "varchar(80)",
        "用户自定义配置名",
        "NOT NULL CHECK (length(btrim(name)) > 0)"
      ],
      [
        "provider",
        "varchar(50)",
        "服务商标识 不限制新增服务商",
        "NOT NULL"
      ],
      [
        "protocol",
        "varchar(16)",
        "接口协议",
        "NOT NULL CHECK (protocol IN ('openai','responses','anthropic','gemini'))"
      ],
      [
        "base_url",
        "text",
        "API 基础地址 不含密钥",
        "NOT NULL CHECK (base_url ~ '^https?://' AND base_url !~* '[?&](key|api_key|token)=')"
      ],
      [
        "model_id",
        "varchar(200)",
        "API 模型 ID 或部署名",
        "NOT NULL CHECK (length(btrim(model_id)) > 0)"
      ],
      [
        "auth_mode",
        "varchar(16)",
        "认证方式",
        "NOT NULL DEFAULT 'bearer' CHECK (auth_mode IN ('bearer','x-api-key','api-key','none'))"
      ],
      [
        "temperature",
        "numeric(3,2)",
        "随机性",
        "NOT NULL DEFAULT 0.70 CHECK (temperature BETWEEN 0 AND 2)"
      ],
      [
        "send_temperature",
        "boolean",
        "是否发送随机性",
        "NOT NULL DEFAULT true"
      ],
      [
        "max_tokens",
        "integer",
        "最大输出预算",
        "NOT NULL DEFAULT 8192 CHECK (max_tokens > 0)"
      ],
      [
        "token_parameter",
        "varchar(24)",
        "长度参数选择",
        "NOT NULL DEFAULT 'auto' CHECK (token_parameter IN ('auto','max_tokens','max_completion_tokens','omit'))"
      ],
      [
        "stream",
        "boolean",
        "是否流式输出",
        "NOT NULL DEFAULT true"
      ],
      [
        "timeout_seconds",
        "integer",
        "总超时秒数",
        "NOT NULL DEFAULT 180 CHECK (timeout_seconds BETWEEN 5 AND 1800)"
      ],
      [
        "extra_body",
        "jsonb",
        "服务商扩展参数",
        "NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(extra_body) = 'object')"
      ],
      [
        "extra_headers",
        "jsonb",
        "不含凭据的扩展请求头",
        "NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(extra_headers) = 'object' AND NOT (extra_headers ?| ARRAY['Authorization','authorization','api-key','x-api-key','x-goog-api-key']))"
      ],
      [
        "is_default",
        "boolean",
        "是否为用户默认配置",
        "NOT NULL DEFAULT false"
      ],
      [
        "created_at",
        "timestamptz",
        "创建时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ],
      [
        "updated_at",
        "timestamptz",
        "最后更新时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ]
    ],
    "constraints": [
      "UNIQUE (user_id, name)",
      "CHECK (protocol <> 'anthropic' OR token_parameter <> 'omit')"
    ],
    "note": "API Key 不属于本表 JSON 扩展仅承载供应商特有参数 核心业务字段仍使用有类型的列"
  },
  {
    "name": "model_credential",
    "label": "模型凭据",
    "fields": [
      [
        "profile_id",
        "uuid",
        "配置主键 一对零或一",
        "PRIMARY KEY REFERENCES model_profile(id) ON DELETE CASCADE"
      ],
      [
        "ciphertext",
        "bytea",
        "AES GCM 密文 含认证标签",
        "NOT NULL CHECK (octet_length(ciphertext) > 16)"
      ],
      [
        "nonce",
        "bytea",
        "每次加密重新生成的随机数",
        "NOT NULL CHECK (octet_length(nonce) = 12)"
      ],
      [
        "key_version",
        "integer",
        "服务端加密密钥版本",
        "NOT NULL CHECK (key_version > 0)"
      ],
      [
        "created_at",
        "timestamptz",
        "创建时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ],
      [
        "updated_at",
        "timestamptz",
        "最后更新时间",
        "NOT NULL DEFAULT CURRENT_TIMESTAMP"
      ]
    ],
    "constraints": [],
    "note": "数据库只存密文和密钥版本 加密主密钥放服务端密钥管理 本 SQL 不实现密码学算法"
  },
