{
  "name": "novel-agent-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "AI 小说创作助手 - 全栈 monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:review": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/chapterHistory.test.mjs packages/frontend/tests/bookConsistency.test.mjs packages/frontend/tests/consistencyStore.test.mjs packages/frontend/tests/characterTimeline.test.mjs",
    "test:review-browser": "node packages/frontend/tests/writingReview.browser.cjs",
    "test:usage": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/usageLedger.test.mjs packages/frontend/tests/modelUsage.test.mjs packages/frontend/tests/generationRetry.test.mjs",
    "test:usage-browser": "node packages/frontend/tests/usageBudget.browser.cjs",
    "test:interactions": "node packages/frontend/tests/workspaceInteractions.browser.cjs",
    "test:mobile-board": "node packages/frontend/tests/mobileCharacterBoard.browser.cjs",
    "test:mobile-space": "node packages/frontend/tests/mobileReadingSpace.browser.cjs",
    "demo:import": "node scripts/import-demo-library.mjs",
    "demo:check": "node scripts/import-demo-library.mjs --check",
    "demo:rebuild": "npm run book:build && npm run school:build && npm run db:generate && node scripts/rebuild-demo-library.mjs",
    "test:database-case": "node --test packages/backend/tests/tideDemo.test.mjs packages/backend/tests/demoLibrary.test.mjs",
    "test:profiles": "node --import tsx --test packages/backend/tests/characterProfiles.test.mjs",
    "test:world": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/worldSettingContent.test.mjs",
    "publication:report": "node scripts/build-publication-report.mjs",
    "test:publication": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/publication.test.mjs",
    "book:build": "node scripts/build-book.mjs",
    "school:build": "node scripts/build-school.mjs",
    "test:book": "node scripts/build-book.mjs && node packages/frontend/tests/book.browser.cjs",
    "test:board": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/characterBoard.test.mjs packages/frontend/tests/boardGestures.test.mjs",
    "test:reference": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/referenceCreation.test.mjs",
    "test:progress": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/outlineProgress.test.mjs",
    "test:writing": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/writingContext.test.mjs",
    "test:demo": "node --import tsx --test packages/frontend/tests/demo.test.mjs packages/frontend/tests/demoSeedPolicy.test.mjs",
    "test:editor": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/editorExport.test.mjs",
    "test:sync": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/structuredContent.test.mjs packages/frontend/tests/autoSync.test.mjs packages/frontend/tests/modificationInstructions.test.mjs",
    "test:models": "node --import tsx --test packages/frontend/tests/modelService.test.mjs",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "db:generate": "npm run prisma:generate --workspace=backend",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:studio": "npm run prisma:studio --workspace=backend",
    "db:reset": "npm run prisma:reset --workspace=backend",
    "test:selection": "tsx --tsconfig packages/frontend/tsconfig.app.json --test packages/frontend/tests/chapterSelection.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "concurrently": "^9.0.1"
  }
}
