// NovelAgent 数据库 Schema
// SQLite + Prisma，未来可平滑迁移到 PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户表
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novels Novel[]

  @@index([email])
}

// ============================================================
// 小说
// ============================================================
model Novel {
  id                  String   @id @default(cuid())
  userId              String
  title               String
  cover               String?
  wordCount           Int      @default(0)
  status              String   @default("draft") // draft | writing | completed
  genre               String?
  summary             String?
  agentPrompt         String?
  lastOpenedChapterId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters       Chapter[]
  characters     Character[]
  worldSettings  WorldSetting[]
  plotCards      PlotCard[]
  foreshadowings Foreshadowing[]

  @@index([userId])
  @@index([userId, updatedAt])
}

// ============================================================
// 章节
// ============================================================
model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  title     String
  content   String   @default("")
  wordCount Int      @default(0)
  sequence  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
  @@index([novelId, sequence])
}

// ============================================================
// 角色
// ============================================================
model Character {
  id                       String  @id @default(cuid())
  novelId                  String
  name                     String
  aliases                  String  @default("[]") // JSON 字符串数组
  description              String  @default("")
  appearance               String?
  personality              String?
  background               String?
  firstAppearanceChapterId String?
  role                     String  @default("supporting") // protagonist | supporting | minor
  sequence                 Int     @default(0)

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
  @@index([novelId, role])
  @@index([novelId, sequence])
}

// ============================================================
// 世界观
// ============================================================
model WorldSetting {
  id       String @id @default(cuid())
  novelId  String
  category String @default("其他")
  title    String
  content  String @default("")

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

// ============================================================
// 大纲 / 情节点
// ============================================================
model PlotCard {
  id        String   @id @default(cuid())
  novelId   String
  type      String   @default("chapter") // volume | chapter
  title     String
  summary   String   @default("")
  sequence  Int      @default(0)
  volumeId  String?  // 章节大纲所属的卷ID
  chapterId String?  // 关联的已写章节
  status    String   @default("pending") // pending | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
  @@index([novelId, type])
  @@index([novelId, volumeId])
}

// ============================================================
// 伏笔
// ============================================================
model Foreshadowing {
  id                 String   @id @default(cuid())
  novelId            String
  title              String
  description        String   @default("")
  plantedChapterId   String?
  resolvedChapterId  String?
  plantedPlotCardId  String?
  resolvedPlotCardId String?
  status             String   @default("planted") // planted | hinted | resolved
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}
